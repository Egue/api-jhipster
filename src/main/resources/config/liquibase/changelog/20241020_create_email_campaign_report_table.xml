<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Changelog para crear la tabla email_campaign_report
        
        Propósito:
        - Almacenar historial de ejecuciones de procesamiento batch
        - Auditoría y trazabilidad de envíos masivos
        - Análisis de rendimiento y tasas de éxito
        
        Fecha: 20 de octubre de 2025
        Autor: Sistema de Email Campaigns
    -->

    <changeSet id="20241020-1" author="developer">
        <comment>Crear tabla email_campaign_report para almacenar reportes de procesamiento batch</comment>
        
        <createTable tableName="email_campaign_report">
            <!-- ID primario autoincremental -->
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_email_campaign_report"/>
            </column>
            
            <!-- ID de la campaña asociada (FK) -->
            <column name="campaign_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            
            <!-- Fecha y hora de inicio del procesamiento -->
            <column name="start_time" type="datetime">
                <constraints nullable="false"/>
            </column>
            
            <!-- Fecha y hora de finalización del procesamiento -->
            <column name="end_time" type="datetime">
                <constraints nullable="true"/>
            </column>
            
            <!-- Total de emails procesados -->
            <column name="total_processed" type="int" defaultValue="0">
                <constraints nullable="true"/>
            </column>
            
            <!-- Cantidad de emails enviados exitosamente -->
            <column name="success_count" type="int" defaultValue="0">
                <constraints nullable="true"/>
            </column>
            
            <!-- Cantidad de emails fallidos -->
            <column name="failed_count" type="int" defaultValue="0">
                <constraints nullable="true"/>
            </column>
            
            <!-- Duración del procesamiento en segundos -->
            <column name="duration_seconds" type="decimal(10,2)">
                <constraints nullable="true"/>
            </column>
            
            <!-- Detalles de errores en formato texto o JSON -->
            <column name="error_details" type="longtext">
                <constraints nullable="true"/>
            </column>
            
            <!-- Fecha de creación del registro (timestamp automático) -->
            <column name="created_date" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20241020-2" author="developer">
        <comment>Agregar foreign key a la tabla email_campaign</comment>
        
        <addForeignKeyConstraint 
            baseTableName="email_campaign_report"
            baseColumnNames="campaign_id"
            referencedTableName="email_campaign"
            referencedColumnNames="id"
            constraintName="fk_report_campaign"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20241020-3" author="developer">
        <comment>Crear índices para optimizar consultas</comment>
        
        <!-- Índice en campaign_id para búsquedas por campaña -->
        <createIndex tableName="email_campaign_report" indexName="idx_report_campaign_id">
            <column name="campaign_id"/>
        </createIndex>
        
        <!-- Índice compuesto en campaign_id y created_date para consultas de historial -->
        <createIndex tableName="email_campaign_report" indexName="idx_report_campaign_created">
            <column name="campaign_id"/>
            <column name="created_date" descending="true"/>
        </createIndex>
        
        <!-- Índice en start_time para consultas de reportes recientes -->
        <createIndex tableName="email_campaign_report" indexName="idx_report_start_time">
            <column name="start_time" descending="true"/>
        </createIndex>
        
        <!-- Índice en failed_count para identificar reportes con errores -->
        <createIndex tableName="email_campaign_report" indexName="idx_report_failed_count">
            <column name="failed_count"/>
        </createIndex>
    </changeSet>

    <changeSet id="20241020-4" author="developer">
        <comment>Agregar comentarios a las columnas para documentación</comment>
        
        <sql>
            ALTER TABLE email_campaign_report COMMENT = 'Tabla de reportes de procesamiento batch de campañas de email';
        </sql>
    </changeSet>

</databaseChangeLog>
